# ==============================================================================
# IT HEALTH CENTER - HOSTINGER APACHE / LITESPEED SECURITY CONFIGURATION
# ==============================================================================

# 1. PREVENT DIRECTORY LISTING
Options -Indexes

# 2. FORCE HTTPS (SSL ENCRYPTION)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# 3. HTTP SECURITY HEADERS
<IfModule mod_headers.c>
  # Protect against MIME-type confusion attacks
  Header set X-Content-Type-Options "nosniff"

  # Prevent Clickjacking / UI Redressing
  Header set X-Frame-Options "SAMEORIGIN"

  # Legacy XSS Filter protection for older browsers
  Header set X-XSS-Protection "1; mode=block"

  # Protect Referrer information leakage
  Header set Referrer-Policy "strict-origin-when-cross-origin"

  # Restrict unauthorized device hardware access
  Header set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"

  # Strict Transport Security (HSTS) - 1 Year + Subdomains
  Header set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" env=HTTPS

  # Content Security Policy (CSP)
  Header set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://cdnjs.cloudflare.com https://cdn.tinytalk.ai https://*.tinytalk.ai https://app.aminos.ai https://*.aminos.ai https://formsubmit.co; style-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com https://fonts.googleapis.com https://cdn.tinytalk.ai https://*.tinytalk.ai https://app.aminos.ai https://*.aminos.ai; font-src 'self' https://cdnjs.cloudflare.com https://fonts.gstatic.com data: https://cdn.tinytalk.ai https://*.tinytalk.ai https://app.aminos.ai; img-src 'self' data: https: blob:; media-src 'self' https://app.aminos.ai https://*.aminos.ai blob: data:; connect-src 'self' https://*.tinytalk.ai https://api.tinytalk.ai https://cdn.tinytalk.ai https://app.aminos.ai https://*.aminos.ai https://formsubmit.co https://*.make.com https://hook.us2.make.com; frame-src 'self' https://*.tinytalk.ai https://cdn.tinytalk.ai https://app.aminos.ai https://*.aminos.ai; object-src 'none'; base-uri 'self';"
</IfModule>

# 4. BLOCK ACCESS TO SENSITIVE HIDDEN FILES AND DIRECTORIES
<FilesMatch "^\.|\.(bak|config|sql|fla|psd|ini|log|sh|inc|swp|dist|env|git|gitignore)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# 5. PROTECT DEPLOY SCRIPTS AND SOURCE FILES
<FilesMatch "(deploy\.ps1|package\.json|package-lock\.json)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# 6. PERFORMANCE & GZIP COMPRESSION
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml
</IfModule>

# 7. BROWSER CACHE CONTROL
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpg "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/gif "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType text/css "access plus 1 week"
  ExpiresByType application/javascript "access plus 1 week"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>
